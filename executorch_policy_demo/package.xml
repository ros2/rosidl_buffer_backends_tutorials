<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>executorch_policy_demo</name>
  <version>0.1.0</version>
  <description>A GPU camera feeding an ExecuTorch policy over CUDA buffer messages, with a CPU message baseline.</description>

  <maintainer email="anthony@shoumikh.in">Anthony Shoumikhin</maintainer>
  <license>Apache-2.0</license>
  <author email="anthony@shoumikh.in">Anthony Shoumikhin</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>cuda-toolkit</depend>
  <depend>executorch_conversions</depend>
  <depend>executorch_cuda_vendor</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>tensor_msgs</depend>

  <exec_depend>cuda_buffer_backend</exec_depend>
  <exec_depend>executorch_conversions_cpu</exec_depend>
  <exec_depend>executorch_conversions_cuda</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
